# Godot 4+ engine-generated folders and files
.godot/
/android/
*.translation

# Godot exports
/export/
/build/
export_presets.cfg

# Steam
steam_appid.txt
# Valve / GodotSteam redistributables never enter the public repo (docs/M3b_RESEARCH.md):
# install them locally; a fresh clone must handle their absence deliberately.
*.dll
*.so
*.dylib
*.lib
*.pdb
addons/godotsteam/**/*.dll
addons/godotsteam/**/*.so
addons/godotsteam/**/*.dylib

# Mono/.NET (unused, standard build)
.mono/
data_*/
mono_crash.*.json

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/

# Local scratch
/tmp/
*.log

# Python (tools/*.py, e.g. triage_log.py)
__pycache__/
*.pyc

# Hand-off archive shipped with the docs
files.zip

# Agent worktrees
/.claude/worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Secrets — this repo is public. Keys live in environment variables, never in the tree.
.env
.env.*
*.key
*_secret*
typesafe_key*
.typesafe/
