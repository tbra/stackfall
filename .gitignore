# Godot 4+ engine-generated folders and files
.godot/
/android/
*.translation

# Godot exports
/export/
/build/
# export_presets.cfg is committed on purpose: tools/export_windows.ps1 relies on the 'Windows Desktop' preset.

# Steam
steam_appid.txt
# Valve / GodotSteam redistributables never enter the public repo (docs/archive/M3b_RESEARCH.md):
# install them locally; a fresh clone must handle their absence deliberately.
*.dll
*.so
*.dylib
*.lib
*.pdb
addons/godotsteam/**/*.dll
addons/godotsteam/**/*.so
addons/godotsteam/**/*.dylib
# Bontago-mv0.2.1 spike: a partial addon (gdextension without every DLL) breaks the
# open-project gate on a fresh clone, so the whole addon stays untracked and is
# installed per developer (README "Steam setup"); tools/check_steam_setup.ps1 verifies it.
/addons/godotsteam/

# Optional developer-local skybox face sets (game/Skybox.gd); third-party
# textures must NEVER be committed to this public repo.
/assets/sky/face_sets/

# Mono/.NET (unused, standard build)
.mono/
data_*/
mono_crash.*.json

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/

# Local scratch
/tmp/
*.log

# Python (tools/*.py, e.g. triage_log.py)
__pycache__/
*.pyc

# Hand-off archive shipped with the docs
files.zip

# Agent worktrees
/.claude/worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Secrets — this repo is public. Keys live in environment variables, never in the tree.
.env
.env.*
*.key
*_secret*
typesafe_key*
.typesafe/

# Throwaway configs written by tools/run_gut.ps1
tests/.gut_targeted/

# Owner feedback drop (screenshots via F12 + written notes); never committed
/feedback/

# Generated by tools/bake_visual_demo.gd; may embed the original game's sky textures
/visual_demo/

# Agent-only window override (tools/agent_worktree_setup.py)
/override.cfg

# Owner-reply hook state (tools/owner_replies.py)
/.claude/owner_replies_state.json
build_info.cfg
