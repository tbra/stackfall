[gd_resource type="Resource" script_class="OptionHelpTable" format=3]

[ext_resource type="Script" path="res://config/ui/OptionHelpTable.gd" id="1_help"]

[resource]
script = ExtResource("1_help")
entries = Dictionary[String, String]({
"AdaptiveQualityCheck": "Temporarily lowers effects when the frame rate drops. Never changes your saved preset.",
"BlockTimerGroup": "How many seconds you have to place each block before it drops by itself.",
"CameraShakeCheck": "Shakes the camera on explosions and heavy impacts. Turn it off if it makes you dizzy.",
"DiscSizeCol": "How big the play disc is. A smaller disc makes for a tighter, more crowded fight.",
"ExperimentsToggleCol": "Master switch for the opt-in experiments. Off: none of them are active and their options are hidden.",
"GameModeCol": "How the match is won. Pick a mode to see its rule here.",
"GameModeCol/0": "Classic: hold every goal flag to win.",
"GameModeCol/1": "Capture the Flag: hold beacons to score; the highest score wins when the round ends.",
"GameModeCol/2": "Elimination: knock out every other team's home flag; the last team standing wins.",
"GameModeCol/3": "Reach the Sky: build the tallest tower; the highest block wins when the round ends.",
"GameModeCol/4": "Domination: control the biggest territory when the round timer ends. A timer is always on.",
"GiftsToggleCol": "Gift crates drop from the sky; a block that catches one earns a special power for its team.",
"GoalFlagCol": "How many goal flags are on the disc. Fewer flags means a faster, more focused match.",
"GravityGroup": "How hard blocks are pulled down. Higher gravity drops blocks faster and hits harder.",
"HoleCol": "What happens to holes that gifts punch in the disc.",
"HoleCol/0": "Temporary: holes close up again after a while.",
"HoleCol/1": "Permanent: holes stay open for the rest of the match.",
"HoleCol/2": "Off: gifts never punch holes in the disc.",
"MatchTimerCol": "Optional time limit. Off: the match runs until a team holds every goal. With sudden death on, the arena shrinks when time is up.",
"MidJoinCol": "Lets players join a match that has already started.",
"QolBacklogCheck": "Experiment: when the block timer runs out the held piece is queued and you get a fresh one, instead of being dropped.",
"QolGiftAfterNextCheck": "Trial: a claimed gift becomes the block after next and your next piece stays. Off: it replaces your next piece.",
"QolGiftSlotCheck": "Experiment: a claimed gift waits in a slot and is spent with the use-gift action, instead of replacing your next block.",
"QolGoalRadiusCheck": "Experiment: a goal can be claimed by territory around the flag, not only on the flag cell itself.",
"QolTimerPauseCheck": "Experiment: the block timer pauses while a special is active or a tower is toppling, so a forced drop cannot land mid-chaos.",
"RoundTimerCol": "How long the round lasts; when it ends the highest score wins. Elimination can run with no limit.",
"RoundTimerDominationCol": "How long the round lasts; when it ends the largest territory share wins. Domination always has a timer.",
"RumbleEnabledCheck": "Vibrates your controller on impacts, explosions and gifts.",
"SkyCol": "Time of day for the match sky. Cycle runs through dawn, day, sunset and night; the other options hold the cycle at one fixed time.",
"SkyCol/0": "Sunset: the sky stays at sunset for the whole match.",
"SkyCol/1": "Night: the sky stays at night for the whole match.",
"SkyCol/2": "Random: the host picks sunset, night or dawn at random when the match starts.",
"SkyCol/3": "Cycle: the sky moves through dawn, day, sunset and night as the match goes on.",
"SkyCol/4": "Dawn: the sky stays at dawn for the whole match.",
"SkyTeamCol": "Reach the Sky: a team's height is the sum of its members' towers instead of its single tallest tower.",
"SpecialFreqGroup": "How often gift crates appear. Higher means more gifts.",
"SuddenDeathCol": "When time runs out, the arena starts shrinking until one team is left.",
"TiltCol": "What tips the disc.",
"TiltCol/0": "Gifts only: the disc tilts only when a gift such as the anvil or a balloon pushes it.",
"TiltCol/1": "Physical balance: the weight of every stack tips the disc, so build evenly.",
"TurnBasedCol": "Players take turns placing blocks instead of everyone placing at once.",
"HudScaleSlider": "Makes only the in-match HUD (scoreboard, timer, minimap, next piece) bigger or smaller. Menus keep their own UI scale.",
"MinimapSizeOption": "How big the minimap is in the corner of the screen during a match.",
"UiScaleSlider": "Makes the menus, lobby and options bigger or smaller. Raise it if text is hard to read on your screen. The in-match HUD has its own scale.",
"WindowModeOption": "Windowed, borderless or exclusive fullscreen. Borderless is the quickest to alt-tab out of.",
"MoveSpeedSlider": "How fast the cursor or stick moves your held block. Lower is more precise.",
"vsync_enabled": "Syncs frames to your monitor to stop screen tearing. Can add a little input delay.",
"frame_cap_mode": "Limits how many frames per second the game draws, which saves power and heat.",
"frame_cap_mode/0": "Display refresh: matches your monitor's refresh rate (vsync). Smooth and tear-free.",
"frame_cap_mode/1": "Fixed: caps the game at the frame rate set below.",
"frame_cap_mode/2": "Uncapped: draws as fast as possible. Can tear and run hot.",
"fixed_fps": "The frame rate cap used when Frame cap is Fixed.",
"glow_enabled": "Soft glow around bright things such as the sun and gifts.",
"msaa_3d": "Smooths jagged edges. Higher costs more graphics power.",
"preset": "Picks Low, Medium or High for every graphics option at once. Changing any option below switches this to Custom.",
"render_scale_3d": "Draws the 3D scene at this share of your screen resolution, then scales it up. Lower is faster but blurrier.",
"render_scale_3d_mode": "How a scaled-down image is stretched back to full size. FSR keeps it sharper than Bilinear.",
"block_outline_enabled": "Draws a thin outline around blocks so their shapes read clearly.",
"environment_detail": "How much scenery, clouds and background effects are drawn.",
"reflections": "Shiny reflections of the sky and scene on the disc and blocks.",
"shadows": "Shadow quality and distance. Higher looks better but costs more graphics power.",
"volumetric_fog_enabled": "Light shafts and fog with real depth. Looks great but is one of the heaviest effects.",
"gift_anvil": "Anvil: drops a heavy weight that tips the disc toward where it lands.",
"gift_black_hole": "Black hole: pulls nearby blocks of every team into it.",
"gift_bomb": "Bomb: thrown, blinks for a few seconds, then explodes and sends nearby blocks flying.",
"gift_earthquake": "Earthquake: shakes the disc and levels out any tilt.",
"gift_freeze": "Freeze: makes your own nearby blocks static for a while.",
"gift_glue": "Glue: your next few placed blocks fuse to whatever they touch.",
"gift_jumping_bean": "Hopper: hops around the disc, punching a hole wherever it lands.",
"gift_magnet": "Magnet: pulls enemy blocks nearby toward itself for a few seconds.",
"gift_paintball": "Paintball: thrown, splashes your colour and turns nearby blocks to your team.",
"gift_propeller": "Balloon: lifts and tips the disc, the opposite of the anvil.",
"gift_rocket": "Rocket: launches along your aim and explodes on impact.",
"gift_volcano": "Volcano: a volcano rises where it is placed and erupts blocks at random for a long while.",
"gift_stackfall": "Stackfall: rains ordinary blocks in your colour onto the map."
})
reserved_lines = 1
