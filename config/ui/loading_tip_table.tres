[gd_resource type="Resource" script_class="LoadingTipTable" load_steps=2 format=3]

[ext_resource type="Script" path="res://config/ui/LoadingTipTable.gd" id="1_tips"]

[resource]
script = ExtResource("1_tips")
tips = PackedStringArray("You can only place blocks inside your own territory. The ghost turns grey where you can't.", "Taller stacks claim more ground. Build up to grow your territory.", "Territory only counts while it connects back to your home flag.", "Where two teams' territory overlaps, nobody can place. It can open into a hole.", "A block that touches a hole dissolves. Keep your stacks off contested ground.", "A refused drop does not use up your piece. Move it and try again.", "Dropping early does not reset the timer. Line up your next piece while you wait.", "If the timer runs out, your held piece drops at the nearest valid spot.", "Tap rotate to turn a block 90 degrees. Reset rotation puts it back.", "Orbit the camera to check your stack from every side before you drop.", "Gift crates parachute onto the disc. One that lands in your territory is yours.", "A gift you claim becomes your block after next.", "Bombs, magnets and hoppers are thrown. Rockets and paintballs fly where the camera points.", "An anvil tilts the disc toward it. A balloon tilts it the other way.", "An earthquake shakes the disc and levels out any tilt.", "Glue fuses your next five placements to whatever they touch.", "Paintball splashes change the owner of nearby blocks, and the ground they claim.", "Falling gifts like bombs go off on a hard hit or when the fuse runs out.", "Blocks that slide off the edge of the disc are gone for good.", "In team games, teammates build in each other's territory and never contest it.", "In Classic, no-build zones around goal flags stop placing, but not your territory.", "In Classic, your team must hold every goal flag at once for a while to win.", "In Elimination, an attacker has to control a home flag for a while to take it.", "In Reach the Sky, your best height is kept even if the tower falls.")
