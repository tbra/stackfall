[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("2_bot_profile")
candidate_count = 70
uses_defensive_specials = true
; DECISION (Bontago-1t5.7, owner 1t5.5 = B): NORMAL now uses offensive specials
; (Rocket/Bomb). No new fields: the existing per-tier aim_noise_m (0.3 m vs
; Hard 0.05 m, applied to throws by BotController) and reaction_delay_s
; (0.6 s vs Hard 0.2 s) already make it slower and less accurate than Hard.
uses_offensive_specials = true
think_budget_us = 700
eval_top_k = 6
pick_temperature = 0.4
intent_mask = 223
pick_pool = 3

; DECISION (Bontago-1t5.34): the V2 brain has its own tier profiles so the shipped legacy brain
; keeps today's Easy/Normal/Hard feel. hard_v2 equals Hard (Bontago-1t5.30 budget kept).
