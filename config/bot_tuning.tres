[sub_resource type="Resource" id="Resource_easy"]
script = ExtResource("2_bot_profile")
candidate_count = 40
stability_raycast_count = 2
aim_noise_m = 0.6
reaction_delay_s = 1.2
think_budget_us = 500
eval_top_k = 0
pick_temperature = 1.0
; DECISION (Bontago-1t5.23): Easy = RACE|ANCHOR|FINISH plus the SIEGE and AREA mode adapters
; (bits 0,1,2,6,7), so it still plays Elimination and Domination.
intent_mask = 199
pick_pool = 5
fill_share = 0.5
; DECISION (Bontago-1t5.25): Easy weighs gifts low.
gift_claim_scale = 0.25

