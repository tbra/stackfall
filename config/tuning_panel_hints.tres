descriptions = {
"WeatherCeilingTuning.height_m": "World height of the upper puff layer's bases above the disc; rain and snow start just below.",
"SnowTuning.cap_rim_width_m": "Width of the soft rounded shoulder along the outer rim of a block's snow layer; sides shared with snowy neighbour cells have none.",
"SnowTuning.cross_merge_enabled": "Touching snowy tops of different blocks at the same height draw as one continuous snow surface (visual only; colliders stay per block).",
"SnowTuning.cross_merge_height_tol_m": "Two block tops count as the same height for snow merging within this many metres.",
"SnowTuning.cross_merge_gap_m": "Largest gap between two blocks top faces that still merges their snow surfaces.",
"SnowTuning.cross_merge_overlap": "Fraction of a cell two block tops must overlap sideways before their snow merges.",
"SnowTuning.cross_merge_checks_per_frame": "Snowy blocks re-examined per frame for moved neighbours (lower is cheaper).",
"SnowTuning.disc_drift_dim": "Brightness of colliding disc drifts relative to the cover tone; lower is softer and darker.",
"SnowTuning.cover_amount_light": "Even base depth of the disc snow cover at the first cover level.",
"SnowTuning.cover_amount_heavy": "Even base depth of the disc snow cover at the top cover level.",
"SnowTuning.cover_variation": "How strongly wind streaks vary the disc snow depth (0 = even sheet, higher = patchier, thinner gaps).",
"SnowTuning.cover_territory_min": "Share of the territory colour (and plate detail) that always shows through disc snow, even at full snow.",
"SnowTuning.cover_wind_stretch": "How many times longer disc snow drifts run along the wind than across it.",
"SnowTuning.cover_wind_angle_deg": "Wind direction of the disc snow streaks, degrees on the disc.",
"SnowTuning.disc_drift_stretch": "How many times longer colliding disc drifts run along the wind than across it.",
"SnowTuning.disc_drift_height_scale": "Height of colliding disc drifts as a fraction of their level height (lower = flatter drifts).",
"WeatherCeilingTuning.min_clearance_above_camera_m": "Rain and snow never start closer than this above the camera.",
"WeatherCeilingTuning.upper_clump_count": "Upper puff clumps on Medium and High (before the preset's puff density).",
"WeatherCeilingTuning.upper_clump_count_low": "Upper puff clumps on the Low preset (before the preset's puff density).",
"WeatherCeilingTuning.upper_ring_outer_m": "Radius of the area around the disc the upper puff clumps cover.",
"WeatherCeilingTuning.upper_clump_radius_min_m": "Smallest upper puff clump radius.",
"WeatherCeilingTuning.upper_clump_radius_max_m": "Largest upper puff clump radius.",
"WeatherCeilingTuning.upper_base_spread_m": "How far above the base height the upper clump bases are spread.",
"WeatherCeilingTuning.upper_seed_offset": "Seed offset that makes the upper puff layout differ from the cloud sea.",
"WeatherCeilingTuning.storm_flare_off_amount": "Storm blend amount at which the sun flare switches off.",
"WeatherCeilingTuning.cloud_overcast_dim": "How much overcast (1 = full) darkens the puffs and the cloud ceiling; shared by every cloud layer.",
"WeatherCeilingTuning.cloud_overcast_desaturate": "How far overcast or storm greys the puffs and ceiling toward neutral; shared by every cloud layer.",
"WeatherCeilingTuning.overcast_rain": "Shared overcast (puff and ceiling darkening and greying) at full rain.",
"WeatherCeilingTuning.overcast_snow": "Shared overcast (puff and ceiling darkening and greying) at full snow.",
"WeatherCeilingTuning.overcast_storm": "Shared overcast (puff and ceiling darkening and greying) at full storm.",
"WeatherCeilingTuning.storm_darkness_add": "Extra ceiling darkening at full storm intensity.",
"WeatherCeilingTuning.max_combined_dim": "Cap on the combined overcast + storm darkening of every cloud layer.",
"WeatherCeilingTuning.night_dim_relief": "Share of the weather darkening removed at full night, so storm and night never stack into black.",
"WeatherCeilingTuning.puff_min_brightness": "Minimum luminance of the lit puff tone after the weather grade (deep slate floor).",
"WeatherCeilingTuning.puff_floor_shadow_ratio": "Shadow tone floor as a share of the minimum puff brightness.",
"WeatherCeilingTuning.puff_floor_mid_ratio": "Mid tone floor as a share of the minimum puff brightness.",
"WeatherCeilingTuning.puff_floor_tint": "Colour of the puff brightness floor (deep slate blue).",
"WeatherCeilingTuning.upper_edge_softness_px": "Soft silhouette width in pixels of the upper puffs (0 = hard cut).",
"WeatherCeilingTuning.sun_overcast_attenuation": "Share of the sun flare, god rays and glow removed at full overcast.",
"WeatherCeilingTuning.sun_storm_attenuation": "Share of the sun flare, god rays and glow removed at full storm.",
"WeatherCeilingTuning.sun_night_fade_end": "Night mix at which the sun flare, god rays and glow are fully off.",
"WeatherCeilingTuning.fade_in_s": "Seconds for the ceiling and storm sky to fade in.",
"WeatherCeilingTuning.fade_out_s": "Seconds for the ceiling and storm sky to fade out after the weather clears.",
"WeatherCeilingTuning.storm_sky_blend": "How far the sky blends toward the storm theme at full storm intensity.",
"WeatherCeilingTuning.spawn_below_ceiling_m": "How far below the lowest layer rain and snow start.",
"WeatherCeilingTuning.rain_below_camera_m": "How far below the camera the rain volume reaches.",
"WeatherCeilingTuning.rain_max_height_m": "Tallest allowed rain volume (limits how thin the rain gets).",
"WeatherCeilingTuning.snow_below_camera_m": "How far below the camera the snow falls before it ends.",
"WeatherCeilingTuning.snow_max_fall_m": "Longest distance snowflakes fall from the ceiling.",
"WeatherCeilingTuning.snow_fall_step_m": "Step the snow fall height is rounded to, so flakes are not rebuilt every frame.",
"SkyThemeDef.sky_look_procedural": "Use the procedural sky (gradient, sun, sea) instead of the painted panorama. Opt-in comparison toggle; off keeps the painted look.",
"SkyThemeDef.procedural_sea_mix": "Blend between painted (0) and procedural (1) sky when the procedural look is on.",
"SkyThemeDef.proc_zenith_color": "Procedural sky colour straight overhead.",
"SkyThemeDef.proc_mid_color": "Procedural sky colour at the middle of the gradient.",
"SkyThemeDef.proc_horizon_color": "Procedural sky colour at the horizon.",
"SkyThemeDef.proc_gradient_mid_height": "Height (0 horizon, 1 zenith) where the middle gradient colour sits.",
