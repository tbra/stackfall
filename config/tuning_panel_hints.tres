descriptions = {
"CameraTuning.mouse_orbit_speed": "How fast the camera orbits (yaw/pitch) per pixel of mouse motion while holding orbit.",
"CameraTuning.orbit_zoom_step": "Metres the camera moves closer or further per wheel notch while the right mouse button (or C) is held.",
"CameraTuning.pad_orbit_speed": "How fast the camera orbits per second at full gamepad stick deflection.",
"CameraTuning.min_pitch_deg": "The lowest (most level) camera pitch angle allowed.",
"CameraTuning.max_pitch_deg": "The highest (steepest downward) camera pitch angle allowed.",
"CameraTuning.zoom_min": "Closest the camera can zoom in.",
"CameraTuning.zoom_max": "Farthest the camera can zoom out.",
"CameraTuning.zoom_step": "Distance the camera moves per zoom step (wheel tick, key press, or trigger pull).",
"CameraTuning.pan_speed": "Meters per second the orbit target pans at full input.",
"CameraTuning.mouse_pan_speed": "Meters the orbit target pans per pixel of mouse motion while panning.",
"CameraTuning.follow_block": "Whether the camera follows the held block (true) or uses the free-orbit camera (false).",
"CameraTuning.follow_lag_seconds": "How many seconds the camera takes to catch up to the held block; 0 tracks it exactly every frame.",
"CameraTuning.follow_distance": "Camera distance from the held block while following it.",
"CameraTuning.follow_pitch_deg": "Camera pitch angle while following the held block.",
"CameraTuning.snap_pitch_deg": "Camera pitch angle used when snapping to home or goal.",
"CameraTuning.snap_distance": "Camera distance used when snapping to home or goal.",
"CameraTuning.snap_duration": "How long the camera snap animation to home/goal takes, in seconds.",
"CameraTuning.fov_deg": "Camera field of view in degrees; lower is flatter, higher looks more fish-eye.",
"GhostTuning.block_move_sensitivity": "Meters the held block's cursor moves per pixel of camera-relative mouse motion.",
"GhostTuning.rotate_drag_sensitivity": "Radians the held block spins per pixel of mouse motion while the middle mouse button is held (horizontal yaws, vertical pitches about the camera's right axis).",
"GhostTuning.ghost_collision_enabled": "Held block stops against placed blocks instead of passing through them (never pushes them).",
"GhostTuning.ghost_collision_skin": "Metres of gap kept between the held block and any placed block it is pushed against.",
"GhostTuning.collision_probe_max_bodies": "How many overlapping bodies one collision probe of the held block may report.",
"GhostTuning.gamepad_cursor_base_speed": "Cursor speed at the gamepad's reference zoom distance.",
"GhostTuning.gamepad_cursor_zoom_reference_distance": "Camera zoom distance at which the gamepad cursor's base speed applies; farther zoom moves the cursor faster.",
"GhostTuning.gamepad_cursor_acceleration": "How quickly the gamepad cursor accelerates toward its target speed.",
"GhostTuning.block_rotation_sensitivity": "Drag units of camera-relative mouse motion per pixel while rotating the held block; one full unit snaps a 90-degree step.",
"GhostTuning.pad_rotation_speed": "Drag units per second of left-stick deflection while rotating the held block with a gamepad.",
"GhostTuning.hover_manual_adjust_speed": "Meters per second the held block's hover height changes while a manual raise/lower input is held.",
"GhostTuning.hover_wheel_step": "Meters the held block's hover height changes per mouse-wheel notch.",
"GhostTuning.hover_manual_max": "Maximum height the held block can be manually raised above the disk surface. DECISION (config/tuning_panel_hints.tres, Bontago-mv0.34): the slider itself is capped at 70 m, not the field's own theoretical range, so it can never be dragged past what NetConfig.pos_max_y (72 m) plus PhysicsTuning.hover_height would actually let the host accept.",
"GhostTuning.placement_ray_length": "Maximum length of the placement raycast used to find where the held block would land.",
"GhostTuning.cursor_ray_height": "Height above the cursor that the placement raycast starts from, so it can see through anything below the cursor.",
"GhostTuning.surface_probe_max_blocks": "Maximum number of stacked blocks the disk-surface probe will skip before giving up.",
"GhostTuning.tint_color": "Base tint color of the held block's ghost preview before a validity state is known.",
"GhostTuning.footprint_alpha": "Opacity of the ghost's footprint projection quads.",
"GhostTuning.footprint_offset": "How far above the landing surface the ghost's footprint quads float, to avoid z-fighting.",
"GhostTuning.projection_alpha": "Opacity of the ghost's vertical projection prism (the walls connecting the held shape to its footprint on the disc).",
"GhostTuning.projection_emission_energy": "How strongly the projection prism's own additive-blended material brightens whatever renders behind or inside it.",
"GhostTuning.projection_uses_state_tint": "Whether the projection prism uses the same valid/invalid/hole/locked colours as the ghost itself, instead of a fixed base tint.",
"GhostTuning.footprint_base_color": "Near-white base colour of the footprint decal on the disc, before any validity-state hue is blended in.",
"GhostTuning.footprint_hue_strength": "How much of the current validity state's own colour is blended into the near-white footprint decal; 0 keeps it pure white, 1 is the full state colour.",
"GhostTuning.invalid_tint_color": "Ghost tint shown when the current placement is outside territory, contested, or off the disk (same grey as the interval-locked tint by default).",
"GhostTuning.hole_tint_color": "Ghost tint shown when the current placement is over a hole.",
"GhostTuning.locked_tint_color": "Ghost tint shown when the placement is otherwise valid but this interval won't allow release yet.",
"GhostTuning.hatch_scale": "UV tiling density of the hole-tint's hatched stripe pattern.",
"GhostTuning.hatch_stripe_width": "Fraction of each hatch tile that is opaque stripe versus see-through gap.",
"GhostTuning.reject_flash_color": "Flash color played when a placement is rejected and thrown off the map.",
"GhostTuning.reject_flash_duration": "How long the reject flash lasts, in seconds.",
"GhostTuning.reject_arc_sideways": "Sideways (world +X) distance the ghost kicks during its reject arc.",
"GhostTuning.reject_arc_height": "Upward (world +Y) distance the ghost kicks during its reject arc.",
"GhostTuning.reject_arc_duration": "How long the reject arc animation plays, in seconds.",
"GhostTuning.auto_drop_flash_color": "Flash color played when the auto-drop timer places the held block automatically.",
"GhostTuning.auto_drop_flash_duration": "How long the auto-drop flash lasts, in seconds.",
"GhostTuning.hud_reject_message_duration": "How long the HUD's reject message stays fully visible before it starts fading.",
"GhostTuning.hud_reject_fade_duration": "How long the HUD's reject message takes to fade out.",
"GhostTuning.spawn_clearance": "Extra height kept above a just-placed block's own top when the next held block's ghost is seeded clear of it.",
"GhostTuning.throw_aim_tint_color": "Ghost tint shown while aiming a throw (holding throw_aim on a held special).",
"GhostTuning.throw_arc_sample_count": "Number of straight segments the throw-aim arc preview is divided into before its own landing cutoff can stop it early.",
"GhostTuning.throw_arc_max_time_s": "Safety-cap seconds of flight the throw-aim arc preview samples out to if it never reaches a landing height at all.",
"GhostTuning.throw_arc_color": "Colour of the throw-aim arc preview line and its landing-point marker.",
"GhostTuning.throw_arc_width": "World-space width, in meters, of the throw-aim arc preview's ribbon.",
"GhostTuning.throw_arc_floor_below_disc_m": "How far below the disc's surface the throw-aim arc preview lands once its XZ has flown past the disc's rim.",
"GhostTuning.throw_arc_floor_enabled": "Whether an off-disc throw-aim arc preview lands on throw_arc_floor_below_disc_m at all, instead of falling until the safety cap.",
"GhostTuning.throw_arc_end_marker_enabled": "Whether the throw-aim arc preview drops a small marker disc at its own landing point.",
"GhostTuning.throw_arc_end_marker_radius": "World-space radius, in meters, of the throw-aim arc preview's landing-point marker disc.",
"PhysicsTuning.cube_size": "Edge length of one physics cube, in meters.",
"PhysicsTuning.cube_margin": "How much each cube's collision box shrinks so neighboring blocks don't jam together.",
"PhysicsTuning.cube_mass": "Mass of one physics cube; a shape's total mass is its cube count times this.",
"PhysicsTuning.block_friction": "Friction of a block's physics material.",
"PhysicsTuning.block_bounce": "Bounciness (restitution) of a block's physics material.",
"PhysicsTuning.block_linear_damp": "Linear damping applied to every block's rigid body; higher values slow falling blocks faster.",
"PhysicsTuning.block_angular_damp": "Angular damping applied to every block's rigid body; higher values slow tumbling blocks faster.",
"PhysicsTuning.disk_friction": "Friction of the playing field's disk surface.",
"PhysicsTuning.kill_plane_y": "World Y height below which any physics body is freed.",
"PhysicsTuning.hover_height": "Height above the surface the ghost preview hovers while aiming a placement.",
"PhysicsTuning.sleep_linear_threshold": "Linear speed below which a block counts as settled for territory rules.",
"PhysicsTuning.sleep_angular_threshold": "Angular speed below which a block counts as settled for territory rules.",
"PhysicsTuning.sleep_settle_time": "How long a block must stay below both settle thresholds before it counts as settled.",
"PhysicsTuning.gravity_multiplier": "Multiplier on world gravity applied to blocks.",
"TerritoryTuning.influence_base": "Base radius of a block's territory influence circle before height scaling.",
"TerritoryTuning.influence_k": "How much a block's height above the disk adds to its territory influence radius.",
"TerritoryTuning.influence_max_fraction": "Maximum influence-circle radius, as a fraction of the field radius.",
"TerritoryTuning.home_radius": "Radius of a home flag's own permanent influence circle.",
"TerritoryTuning.max_circles": "Maximum influence circles kept live at once; extra small circles are dropped in favor of the largest per team.",
"TerritoryTuning.solve_hz": "How many times per second territory ownership is recomputed.",
"TerritoryTuning.raster_upload_hz": "How many times per second the territory raster/circle list is uploaded for rendering and networking.",
"TerritoryTuning.hash_cell_size": "Size of the spatial-hash cells used to speed up territory circle overlap checks.",
"TerritoryTuning.hole_delay": "How long a cell must stay contested before it becomes a hole.",
"TerritoryTuning.hole_close_delay": "How long a temporary hole stays open after the contest that created it ends.",
"TerritoryTuning.max_cell_toggles_per_frame": "Maximum territory cells allowed to change ownership in a single frame.",
"TerritoryTuning.goal_zone_radius": "Radius of the no-build zone around every goal flag.",
"TerritoryTuning.capture_hold": "How long one connected territory must contain every goal flag to win.",
"TerritoryTuning.auto_drop_search_step": "Distance between each ring of the spiral search used to auto-drop a block to the nearest valid spot.",
"TerritoryTuning.auto_drop_search_max_radius": "Maximum distance the auto-drop spiral search will look before giving up.",
"TerritoryTuning.reject_impulse": "Strength of the impulse applied to a block that's thrown off the map for an invalid placement.",
"TerritoryTuning.reject_upward_fraction": "Fraction of the reject impulse aimed straight up; the rest points radially outward from the disk center.",
"TerritoryVisuals.disk_base_color": "Color of the disk surface where no team owns the ground.",
"TerritoryVisuals.disk_metallic": "Metallic value of the disk's mirror-like opaque surface; higher makes ProceduralSky reflections stronger.",
"TerritoryVisuals.disk_roughness": "Roughness value of the disk's mirror-like opaque surface; lower makes reflections sharper.",
"TerritoryVisuals.disk_mesh_segments": "Radial segments in the disk mesh; higher makes the rim read as a circle rather than a polygon.",
"TerritoryVisuals.edge_softness": "How blurry the territory tint's edge is where ownership changes.",
"TerritoryVisuals.tint_alpha": "How strongly a team's color tints the disk at full territory coverage.",
"TerritoryVisuals.outline_width": "Width of the animated outline band drawn around a territory edge.",
"TerritoryVisuals.outline_speed": "Pulses per second of the territory outline's animation.",
"TerritoryVisuals.outline_strength": "Emission strength of the territory outline at the peak of its pulse.",
"TerritoryVisuals.outline_pulse_depth": "How much of the territory outline's brightness is animated versus a constant glow.",
"TerritoryVisuals.contested_color": "Color of the shimmer shown over contested cells.",
"TerritoryVisuals.contested_shimmer_rate": "Shimmer cycles per second over contested cells.",
