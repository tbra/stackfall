"TerritoryVisuals.goal_flag_scale": "How much larger a goal flag's banner is than a home flag's.",
"TerritoryVisuals.goal_flag_color": "Color of a goal flag's banner.",
"TerritoryVisuals.flag_emission": "Emission strength of a flag's banner, so ownership reads at a glance.",
"TerritoryVisuals.capture_ring_radius": "Outer radius of the capture-progress ring shown on a goal flag while it's being captured.",
"TerritoryVisuals.capture_ring_thickness": "Thickness of the capture-progress ring.",
"TerritoryVisuals.capture_ring_lift": "Height above the disk surface the capture ring floats, to avoid z-fighting.",
"TerritoryVisuals.capture_ring_segments": "Segments in the full capture-ring circle; the drawn arc uses a proportional share.",
