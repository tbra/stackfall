"SkyThemeDef.cycle_locked_phase_night": "Time of day the lobby Night option is frozen at; 0.75 is midnight.",
"SkyThemeDef.cycle_dusk_weight_phases": "Day palette blend phases (a, b, c, d): the dawn palette fades into the sunset palette between a and b and back out between c and d. Not a slider row.",
"SkyThemeDef.variation_enabled": "Let the cycle sky's exposure and cloud coverage wander inside the ranges below (a smooth function of the match seed and time of day, the same on every peer). Off = the sunset theme's own fixed values.",
"SkyThemeDef.variation_exposure_min": "Lowest sky exposure the varying cycle reaches (Dawn 0.95, Sunset 0.8); weather overcast and storms still dim it from wherever it is.",
"SkyThemeDef.variation_exposure_max": "Highest sky exposure the varying cycle reaches.",
"SkyThemeDef.variation_cloud_coverage_min": "Lowest overhead-cloud threshold the varying cycle reaches (lower = more clouds; Dawn 0.5, Sunset 0.68). Only visible while Overhead clouds are on.",
"SkyThemeDef.variation_cloud_coverage_max": "Highest overhead-cloud threshold the varying cycle reaches (higher = fewer clouds).",
"SkyThemeDef.variation_sea_coverage_min": "Lowest cloud-floor threshold under the horizon the varying cycle reaches (lower = a thicker cloud floor); the far puffs follow it.",
"SkyThemeDef.variation_sea_coverage_max": "Highest cloud-floor threshold under the horizon the varying cycle reaches (higher = a sparser floor).",
"SkyThemeDef.variation_knots_per_cycle": "How many times a day the varying sky swings between its limits (the average swing is the cycle length divided by this; 3 = 100 s of a 300 s day). Always smooth.",
"SnowTuning.melt_duration_s": "Seconds the snow takes to melt away once snowfall stops; never longer than the weather's ramp-out.",
"SnowTuning.cover_ease_s": "Seconds the snow on the disc takes to spread or retreat by one level (0 snaps between levels).",
"SnowTuning.flake_below_camera_m": "How far below the camera the falling flakes keep going, so the disc in the lower part of the view gets flakes too.",
"SnowTuning.flake_forward_shift_m": "How far the falling flakes' box is moved from the camera along its horizontal look direction, so the whole view across the disc gets flakes, not only the part under the camera.",
"SnowTuning.flake_max_column_m": "Tallest column of falling flakes: they start at most this far above the camera instead of at the far cloud ceiling, packing the same flakes closer to the view.",
"SnowTuning.flake_min_angle": "Smallest apparent size of a falling flake as an angle in radians, so far flakes stay visible (about 0.008 = 4.7 px at 720p).",
"SnowTuning.flake_max_angle": "Largest apparent size of a falling flake as an angle in radians, so flakes close to the camera never become blobs.",
"SnowTuning.flake_stop_intensity": "While snowfall ends the flakes thin out and are gone once the weather intensity falls to this share of its peak; the rest is only melting.",
"SnowTuning.flake_edge_color": "Cool outline colour of a falling flake, so the white flake reads against the bright sky.",
"SnowTuning.flake_prefill": "Fill the whole fall column the moment snowfall starts, instead of waiting for the first flakes to fall from the clouds.",
"SnowTuning.flake_sim_fps": "Flake simulation steps per second (movement is interpolated); lower is cheaper, and the pre-fill costs one lifetime of steps.",
"SnowTuning.flake_edge_start": "How far out from the centre of a flake its cool outline starts (0 = centre, 1 = rim).",
"HorizonStormConfig.enabled": "Show the distant storm cells on the horizon during storm weather.",
"HorizonIslandsConfig.enabled": "Show the ring of floating islands on the horizon.",
"HorizonIslandsConfig.count": "Number of floating islands in the horizon ring (0 hides them).",
"HorizonIslandsConfig.radius_min_m": "Nearest ring distance of an island from the arena center.",
"HorizonIslandsConfig.radius_max_m": "Farthest ring distance of an island from the arena center.",
"HorizonIslandsConfig.height_min_m": "Lowest world height of an island's cap surface; keep the hanging rock above the horizon cloud banks.",
"HorizonIslandsConfig.height_max_m": "Highest world height of an island's cap surface.",
"HorizonIslandsConfig.scale_min": "Smallest uniform island scale.",
"HorizonIslandsConfig.scale_max": "Largest uniform island scale.",
"HorizonIslandsConfig.angle_jitter": "Random angular jitter inside each ring slot (0 even, 1 whole slot).",
"HorizonIslandsConfig.seed": "Seed mixed with the map id for deterministic island placement.",
"HorizonIslandsConfig.lod1_begin_m": "Camera distance where the island switches from LOD0 to LOD1.",
"HorizonIslandsConfig.lod2_begin_m": "Camera distance where the island switches from LOD1 to LOD2.",
"HorizonIslandsConfig.visibility_end_m": "Camera distance beyond which islands are culled (0 never).",
"HorizonIslandsConfig.stretch_fraction": "Independent width/depth stretch per island (fraction of its scale).",
"HorizonIslandsConfig.tilt_max_deg": "Maximum random tilt of an island in degrees.",
"HorizonIslandsConfig.toward_tilt_deg": "Tilt of each island's cap toward the arena so the camera sees its top (degrees).",
"HorizonIslandsConfig.haze_amount": "How strongly island colours blend toward the live sky haze colour.",
"HorizonIslandsConfig.color_gain": "Brightness multiplier on the island facet colours.",
"HorizonIslandsConfig.cap_normal_min_y": "Facets facing at least this much upward count as the island's cap (top).",
"HorizonIslandsConfig.cap_tint": "Colour multiplier for island cap (top) facets.",
"HorizonIslandsConfig.rock_tint": "Colour multiplier for the island's hanging rock body.",
"HorizonIslandsConfig.shadow_level": "Brightness of island facets turned away from the sun.",
"HorizonIslandsConfig.mid_level": "Brightness of half-lit island facets (sun-facing facets are full brightness).",
"CloudShadowConfig.max_strength": "Darkness of cloud shadows on the arena at full strength (0 = no cloud shadows).",
"CloudShadowConfig.shadow_color": "Tint multiplied into surfaces under a cloud shadow.",
"CloudShadowConfig.coverage": "Share of the sky covered by shadow-casting cloud.",
"CloudShadowConfig.edge_softness": "Softness of the cloud shadow edges.",
"CloudShadowConfig.feature_size_m": "Typical size of a cloud shadow on the ground, in metres.",
"CloudShadowConfig.wind_heading_deg": "Direction the cloud shadows travel, degrees from +X toward +Z.",
"CloudShadowConfig.speed_scale": "Multiplier on the cloud drift speed for the shadow ground speed.",
"CloudShadowConfig.layer_period_s": "Seconds one cross-fading shadow layer takes to sweep its travel.",
"CloudShadowConfig.min_sun_sin": "Sun elevation (sine) below which cloud shadows vanish.",
"CloudShadowConfig.full_sun_sin": "Sun elevation (sine) above which cloud shadows are at full strength.",
"CloudShadowConfig.field_margin": "Cloud shadow volume size relative to the field radius.",
"CloudShadowConfig.volume_height_m": "Height in metres of the volume the cloud shadows are projected onto.",
"CloudShadowConfig.span_m": "Ground span in metres one cloud shadow layer covers; bigger lets shadows sweep farther.",
"CloudShadowConfig.noise_texture_size": "Pixel size of the generated cloud shadow noise textures.",
"CloudShadowConfig.noise_seed": "Random seed of the cloud shadow noise.",
"CloudShadowConfig.sun_dim_max": "Share of the direct sun lost when clouds fully cover the sun direction.",
"CloudShadowConfig.sun_dim_rate": "How fast the sun dimming follows cloud cover, per second.",
"CloudShadowConfig.occlusion_refresh_s": "Seconds between cloud cover queries for the sun dimming.",
"CloudShadowConfig.sun_ray_origin_height_m": "Height above the disc the sun cloud-cover ray starts from, in metres.",
"HorizonStormConfig.cell_count_min": "Fewest horizon storm cells shown during a storm.",
"HorizonStormConfig.cell_count_max": "Most horizon storm cells shown during a storm (each uses a different silhouette).",
"HorizonStormConfig.distance_m": "Distance (m) from the arena centre to a horizon storm cell; keep it far beyond the play field.",
"HorizonStormConfig.distance_jitter_m": "Each cell's distance varies by up to this many metres either way.",
"HorizonStormConfig.cell_scale": "Uniform scale of the 56 m wide authored storm cell; with distance sets how small it looks.",
"HorizonStormConfig.elevation_m": "Height (m) of a storm cell's cloud mid line above the arena top plane.",
"HorizonStormConfig.min_bearing_separation_deg": "Minimum degrees between two storm cells around the horizon.",
"HorizonStormConfig.seed_salt": "Mixed into the match seed so the horizon layout differs from other seeded visuals.",
"HorizonStormConfig.min_intensity": "Storm intensity below which the horizon cells are fully hidden.",
"HorizonStormConfig.fade_rate_per_s": "Opacity change per second while the horizon cells follow the storm intensity.",
"HorizonStormConfig.first_flash_min_s": "Shortest wait (s) before a cell's first lightning flash.",
"HorizonStormConfig.first_flash_max_s": "Longest wait (s) before a cell's first lightning flash.",
"HorizonStormConfig.flash_interval_min_s": "Shortest gap (s) between lightning flashes of one horizon cell.",
"HorizonStormConfig.flash_interval_max_s": "Longest gap (s) between lightning flashes of one horizon cell.",
"CloudDriftConfig.calm_heading_deg": "Direction the clouds drift in calm weather, degrees from +X toward +Z.",
"CloudDriftConfig.calm_heading_jitter_deg": "How far each match may turn the calm cloud wind from that heading, in degrees.",
"CloudDriftConfig.upper_rate": "Drift speed of the cloud layer above the disc, relative to its own speed (nearest, fastest).",
"CloudDriftConfig.sea_rate": "Drift speed of the cloud sea below the disc, relative to its own speed.",
"CloudDriftConfig.bank_rate": "Drift speed of the distant cloud banks, relative to their own speed.",
"CloudDriftConfig.far_rate": "Drift speed of the farthest cloud sea, relative to its own speed (slowest).",
"CloudDriftConfig.storm_speed_mult": "How many times faster the clouds drift in a full storm.",
"CloudDriftConfig.heading_follow_rate": "How fast the cloud drift turns toward the wind, per second.",
"CloudDriftConfig.speed_follow_rate": "How fast the cloud drift speed eases toward the wind speed, per second.",
"CloudDriftConfig.edge_fade_m": "Width in metres of the dissolve at the edge of the cloud field where clouds wrap around.",
"CloudDriftConfig.exclusion_fade_m": "Width in metres over which cloud sea fades out near the disc.",
}
