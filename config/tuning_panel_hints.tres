"SkyThemeDef.sky_look_procedural": "Use the procedural sky (gradient, sun, sea) instead of the painted panorama. Opt-in comparison toggle; off keeps the painted look.",
"SkyThemeDef.procedural_sea_mix": "Blend between painted (0) and procedural (1) sky when the procedural look is on.",
"SkyThemeDef.proc_zenith_color": "Procedural sky colour straight overhead.",
"SkyThemeDef.proc_mid_color": "Procedural sky colour at the middle of the gradient.",
"SkyThemeDef.proc_horizon_color": "Procedural sky colour at the horizon.",
"SkyThemeDef.proc_gradient_mid_height": "Height (0 horizon, 1 zenith) where the middle gradient colour sits.",
"SkyThemeDef.proc_gradient_power": "Curve exponent shaping how fast the gradient leaves the horizon colour.",
"SkyThemeDef.proc_horizon_glow_color": "Colour of the warm glow band along the horizon.",
"SkyThemeDef.proc_horizon_glow_width": "Height of the horizon glow band (0..1 of the upper hemisphere).",
"SkyThemeDef.proc_sun_glow_strength": "Strength of the procedural sun disc and halo.",
"SkyThemeDef.proc_sea_color_near": "Procedural cloud-sea colour just below the horizon.",
"SkyThemeDef.proc_sea_color_far": "Procedural cloud-sea colour looking steeply down.",
"SkyThemeDef.proc_sea_horizon_fade": "How far below the horizon the sea blends into the horizon colour.",
"SkyThemeDef.proc_strata_scale": "Scale of the procedural upper cloud strata.",
"SkyThemeDef.proc_overhead_clouds_enabled": "Show the procedural look's overhead clouds (cards or noise layers). Off by default.",
"SkyThemeDef.cloud_puff_raise_m": "Metres the cloud-puff layer is raised; puffs near the disc are still clamped below it.",
"SkyThemeDef.cloud_disc_clearance_ratio": "Clearance kept around the disc, as a fraction of the largest field radius.",
"SkyThemeDef.proc_cards_enabled": "Use the authored cloud-card atlas for the overhead clouds instead of the noise layers (procedural sky look only).",
"SkyThemeDef.proc_cards_density": "Chance that a sky grid cell holds a cloud card; higher fills the sky with more banks.",
"SkyThemeDef.proc_cards_scale": "Cloud-card grid scale overhead; higher gives more, smaller cards.",
"SkyThemeDef.proc_cards_opacity": "Overall opacity of the overhead cloud cards.",
"SkyThemeDef.cycle_length_seconds": "Length in seconds of one full day/night cycle (CYCLE sky mode); default 300 (5 min). Applies live to this client only and keeps the current time of day.",
"SkyThemeDef.cycle_sun_peak_degrees": "Highest sun elevation in degrees reached at midday in the cycle.",
"SkyThemeDef.cycle_twilight_width": "Fraction of the cycle spent blending through dawn/dusk.",
"SkyThemeDef.cycle_star_brightness": "Brightness multiplier of the night stars.",
"SkyThemeDef.cycle_star_cells": "Star grid density (higher = more, smaller stars).",
"SkyThemeDef.cycle_star_threshold": "Cell threshold above which a star is drawn (higher = fewer stars).",
"SkyThemeDef.cycle_star_radius": "Star dot radius within its grid cell.",
"SkyThemeDef.cycle_star_horizon_fade": "How far above the horizon stars fade in.",
"SkyThemeDef.cycle_moon_angular_radius_deg": "Angular radius of the visible night-sky moon disc, in degrees.",
"SkyThemeDef.cycle_moon_halo_radius_deg": "Angular radius of the soft halo around the moon, in degrees.",
"SkyThemeDef.cycle_moon_halo_strength": "Brightness of the moon halo glow.",
"SkyThemeDef.cycle_moon_brightness": "Brightness multiplier of the moon disc.",
"SkyThemeDef.cycle_moon_full_night_mix": "How dark (night mix) the sky must be before the moon is fully visible; lower shows it earlier at dusk.",
"SkyThemeDef.aurora_enabled": "Show the aurora borealis curtains in the night sky (also off on the Low graphics preset).",
"SkyThemeDef.aurora_intensity": "Brightness of the aurora curtains.",
"SkyThemeDef.aurora_color_low": "Colour of the aurora's bright lower edge (green).",
"SkyThemeDef.aurora_color_mid": "Colour of the aurora's middle (teal).",
"SkyThemeDef.aurora_color_top": "Colour of the aurora's faint upper tips (violet).",
"SkyThemeDef.aurora_speed": "How fast the aurora drifts and ripples; 1 is the default slow drift, 0 freezes it.",
"SkyThemeDef.aurora_base_height": "Mean sky elevation of the aurora's lower edge (0 horizon, 0.5 = 30 degrees up, 1 overhead).",
"SkyThemeDef.aurora_curtain_height": "How far the curtains reach above their lower edge, in the same sky elevation units.",
"SkyThemeDef.aurora_start_night_mix": "How dark (night mix) the sky must be before the aurora starts to fade in at dusk.",
"SkyThemeDef.aurora_full_night_mix": "Night mix at which the aurora is fully visible; between this and the start value it fades in.",
"SkyThemeDef.aurora_always_on": "A fixed (non-cycle) theme has no night mix: on shows the aurora at full strength under it (the Night theme), off never shows it. The cycle ignores this.",
"SkyThemeDef.cycle_sun_energy_gain": "Direct sun energy multiplier with the sun high in the cycle (1 at the horizon); raises lit-vs-shadow contrast by day.",
"SkyThemeDef.cycle_day_ambient_scale": "Sky ambient multiplier with the sun high in the cycle (1 at the horizon and at night); lower makes shadowed faces darker by day.",
"SkyThemeDef.cycle_sun_contrast_full_sin": "Sun elevation (sine, 1 = overhead) at which the full sun gain and ambient scale apply; the effect fades toward the horizon.",
"SkyThemeDef.proc_far_count": "Number of far puff clumps (procedural sky look only) reaching toward the horizon; 0 disables the ring.",
"SkyThemeDef.proc_far_ring_inner_m": "Nearest distance from the disc axis of the far puff ring (procedural look).",
"SkyThemeDef.proc_far_ring_outer_m": "Farthest distance from the disc axis of the far puff ring (procedural look).",
"SkyThemeDef.proc_far_radial_bias": "Crowds far clumps toward the ring's inner edge: 1 is even over the ring's area, higher is denser near.",
"SkyThemeDef.proc_far_base_min_m": "Lowest world Y of a far puff clump base.",
"SkyThemeDef.proc_far_base_max_m": "Highest world Y of a far puff clump base.",
"SkyThemeDef.proc_far_top_max_m": "Ceiling no far puff top may cross.",
"SkyThemeDef.proc_far_radius_min_m": "Smallest far clump radius in metres.",
"SkyThemeDef.proc_far_radius_max_m": "Largest far clump radius in metres.",
"SkyThemeDef.proc_far_fade_cap": "Most that distance haze may blend a puff into the sky colour (1 = fully, lower keeps distant cumulus shaded).",
"SkyThemeDef.sun_flare_enabled": "Whether the screen-space sun lens flare is drawn under this sky theme (off for night).",
"SkyThemeDef.sky_yaw_offset_deg": "Rotate panorama longitude sampling to align its painted sun with the flare; reflections rotate with it.",
"SkyThemeDef.sky_pitch_offset_deg": "Shift panorama latitude sampling in degrees to align sun elevation; zero preserves the authored horizon.",
"PhysicsTuning.release_tilt_degrees": "Experimental deterministic release tilt for high drops; zero disables it and contacts still use real solver forces.",
"PhysicsTuning.release_tilt_min_gap_cubes": "Minimum bottom-to-support gap in cube edges before a newly released block receives the experimental tilt.",
"CameraTuning.mouse_orbit_speed": "How fast the camera orbits (yaw/pitch) per pixel of mouse motion while holding orbit.",
