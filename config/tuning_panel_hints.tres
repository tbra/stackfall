"SkyThemeDef.proc_sea_color_far": "Procedural cloud-sea colour looking steeply down.",
"SkyThemeDef.proc_sea_horizon_fade": "How far below the horizon the sea blends into the horizon colour.",
"SkyThemeDef.proc_strata_scale": "Scale of the procedural upper cloud strata.",
"SkyThemeDef.proc_overhead_clouds_enabled": "Show the procedural look's overhead clouds (cards or noise layers). Off by default.",
"SkyThemeDef.cloud_puff_raise_m": "Metres the cloud-puff layer is raised; puffs near the disc are still clamped below it.",
"SkyThemeDef.cloud_disc_clearance_ratio": "Clearance kept around the disc, as a fraction of the largest field radius.",
"SkyThemeDef.proc_cards_enabled": "Use the authored cloud-card atlas for the overhead clouds instead of the noise layers (procedural sky look only).",
"SkyThemeDef.proc_cards_density": "Chance that a sky grid cell holds a cloud card; higher fills the sky with more banks.",
"SkyThemeDef.proc_cards_scale": "Cloud-card grid scale overhead; higher gives more, smaller cards.",
"SkyThemeDef.proc_cards_opacity": "Overall opacity of the overhead cloud cards.",
"SkyThemeDef.cycle_length_seconds": "Length in seconds of one full day/night cycle (CYCLE sky mode); default 300 (5 min). Applies live to this client only and keeps the current time of day.",
"SkyThemeDef.cycle_sun_peak_degrees": "Highest sun elevation in degrees reached at midday in the cycle.",
"SkyThemeDef.cycle_twilight_width": "Fraction of the cycle spent blending through dawn/dusk.",
"SkyThemeDef.cycle_star_brightness": "Brightness multiplier of the night stars.",
"SkyThemeDef.cycle_star_cells": "Star grid density (higher = more, smaller stars).",
"SkyThemeDef.cycle_star_threshold": "Cell threshold above which a star is drawn (higher = fewer stars).",
"SkyThemeDef.cycle_star_radius": "Star dot radius within its grid cell.",
"SkyThemeDef.cycle_star_horizon_fade": "How far above the horizon stars fade in.",
"SkyThemeDef.proc_far_count": "Number of far puff clumps (procedural sky look only) reaching toward the horizon; 0 disables the ring.",
"SkyThemeDef.proc_far_ring_inner_m": "Nearest distance from the disc axis of the far puff ring (procedural look).",
"SkyThemeDef.proc_far_ring_outer_m": "Farthest distance from the disc axis of the far puff ring (procedural look).",
"SkyThemeDef.proc_far_radial_bias": "Crowds far clumps toward the ring's inner edge: 1 is even over the ring's area, higher is denser near.",
"SkyThemeDef.proc_far_base_min_m": "Lowest world Y of a far puff clump base.",
"SkyThemeDef.proc_far_base_max_m": "Highest world Y of a far puff clump base.",
"SkyThemeDef.proc_far_top_max_m": "Ceiling no far puff top may cross.",
"SkyThemeDef.proc_far_radius_min_m": "Smallest far clump radius in metres.",
"SkyThemeDef.proc_far_radius_max_m": "Largest far clump radius in metres.",
"SkyThemeDef.proc_far_fade_cap": "Most that distance haze may blend a puff into the sky colour (1 = fully, lower keeps distant cumulus shaded).",
"SkyThemeDef.sun_flare_enabled": "Whether the screen-space sun lens flare is drawn under this sky theme (off for night).",
"SkyThemeDef.sky_yaw_offset_deg": "Rotate panorama longitude sampling to align its painted sun with the flare; reflections rotate with it.",
"SkyThemeDef.sky_pitch_offset_deg": "Shift panorama latitude sampling in degrees to align sun elevation; zero preserves the authored horizon.",
