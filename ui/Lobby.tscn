[node name="QolBacklogCheck" type="Button" parent="Margin/Layout/Columns/SettingsCard/SettingsCardLayout/SettingsScroll/Settings/ExperimentsSection/Advanced/ExperimentsGroup/ExperimentsChecklist"]
unique_name_in_owner = true
script = ExtResource("12_chip")
layout_mode = 2
size_flags_horizontal = 3
label = "Queue expired blocks"
tooltip_text = "Experiment: when the block timer runs out the held piece is queued and you get a fresh one, instead of being dropped."

[node name="QolGoalRadiusCheck" type="Button" parent="Margin/Layout/Columns/SettingsCard/SettingsCardLayout/SettingsScroll/Settings/ExperimentsSection/Advanced/ExperimentsGroup/ExperimentsChecklist"]
unique_name_in_owner = true
script = ExtResource("12_chip")
layout_mode = 2
size_flags_horizontal = 3
label = "Bigger goal claim radius"
tooltip_text = "Experiment: a goal can be claimed by territory around the flag, not only on the flag cell itself."

[node name="QolGiftSlotCheck" type="Button" parent="Margin/Layout/Columns/SettingsCard/SettingsCardLayout/SettingsScroll/Settings/ExperimentsSection/Advanced/ExperimentsGroup/ExperimentsChecklist"]
unique_name_in_owner = true
script = ExtResource("12_chip")
layout_mode = 2
size_flags_horizontal = 3
label = "Gift slot"
tooltip_text = "Experiment: a claimed gift waits in a slot and is spent with the use-gift action, instead of replacing your next block."

