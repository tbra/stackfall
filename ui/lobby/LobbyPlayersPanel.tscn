[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/lobby/LobbyPlayersPanel.gd" id="1_panel"]

[node name="LobbyPlayersPanel" type="VBoxContainer"]
size_flags_vertical = 3
theme_override_constants/separation = 8
