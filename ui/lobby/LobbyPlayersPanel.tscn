[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/lobby/LobbyPlayersPanel.gd" id="1_panel"]
[ext_resource type="Script" path="res://ui/FocusScrollContainer.gd" id="2_scroll"]

[node name="LobbyPlayersPanel" type="VBoxContainer"]
size_flags_vertical = 3
theme_override_constants/separation = 8
script = ExtResource("1_panel")

[node name="TitleRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="TitleRow"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Players"

[node name="PlayersTitleSpacer" type="Control" parent="TitleRow"]
layout_mode = 2

[node name="PlayerCountLabel" type="Label" parent="TitleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 2
text_overrun_behavior = 3
clip_text = true
mouse_filter = 0
theme_override_font_sizes/font_size = 20
text = "0 / 8"

[node name="ActionRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="TeamsToggle" type="CheckButton" parent="ActionRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Teams: seats with the same number play as one team; ? is filled in at match start"
disabled = true
text = "Teams"

[node name="ActionRowSpacer" type="Control" parent="ActionRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="AddBotButton" type="Button" parent="ActionRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
focus_mode = 0
tooltip_text = "Add a bot to the next free seat"
disabled = true
text = "+ Add bot"

[node name="PlayerScroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 3
script = ExtResource("2_scroll")

[node name="PlayerList" type="VBoxContainer" parent="PlayerScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="StartBlockerLabel" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 3
