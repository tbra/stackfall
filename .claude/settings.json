{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python tools/session_brief.py",
            "type": "command"
          },
          {
            "command": "python tools/owner_replies.py",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bd prime --hook-json --no-memories",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python tools/owner_replies.py",
            "timeout": 45,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}