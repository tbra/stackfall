{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/session_brief.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/owner_replies.py\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime --hook-json --no-memories"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guard_store_python.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "bead-board@claude-mods": true,
    "human-desk@claude-mods": true,
    "agent-floor@claude-mods": true,
    "token-weather@claude-mods": true,
    "image-panel@claude-mods": true
  },
  "extraKnownMarketplaces": {
    "claude-mods": {
      "source": {
        "source": "directory",
        "path": "M:\\claude-mods"
      }
    }
  }
}
